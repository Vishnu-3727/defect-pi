# This repo is authored on Windows and deployed to Linux (Raspberry Pi 5).
# Without this, core.autocrlf rewrites shell scripts with CRLF and they fail on
# the Pi with "bad interpreter: /bin/bash^M". Normalise everything to LF.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.ino  text eol=lf

*.onnx binary
*.npz  binary
*.pt   binary
*.jpg  binary
*.png  binary
*.db   binary
