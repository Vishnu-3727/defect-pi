[Desktop Entry]
Type=Application
Name=Defect Inspection Demo
Comment=Start the surface defect inspection demo (stops the UNIFY-RUL demo)
# Bare command on purpose -- see the note in unify-rul.desktop. Conflicts= in
# the unit file stops the other demo; the browser tab on :5000 stays open.
Exec=systemctl --user start defect-inspect.service
Icon=camera-photo
Terminal=false
StartupNotify=false
Categories=Utility;
